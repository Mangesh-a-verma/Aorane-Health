{
  "installCommand": "npx --yes pnpm@10 install --no-frozen-lockfile --ignore-scripts && npx --yes pnpm@10 rebuild esbuild",
  "buildCommand": "NODE_ENV=production BASE_PATH=/ VITE_API_URL=https://aorane.onrender.com npx pnpm@10 --filter @workspace/aorane-landing build",
  "outputDirectory": "artifacts/aorane-landing/dist/public",
  "framework": null,
  "rewrites": [
    { "source": "/features", "destination": "/features/index.html" },
    { "source": "/pricing", "destination": "/pricing/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/careers", "destination": "/careers/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/medical-disclaimer", "destination": "/medical-disclaimer/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
