# FIX C5 — Firebase config must NOT be committed. Inject via EAS Build secret file
# or codemagic CM_*_VARIABLE before build. Keeping it in git lets anyone who clones
# the repo run a working Firebase app under your project, abuse FCM push tokens, etc.
google-services.json
GoogleService-Info.plist

