{
  "expo": {
    "name": "AORANE",
    "slug": "aorane-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aorane",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "privacyPolicyUrl": "https://aorane.in/privacy",
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#010814"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.aorane.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AORANE uses your location to find nearby doctors, pharmacies and hospitals.",
        "NSFaceIDUsageDescription": "AORANE uses Face ID for quick and secure login.",
        "NSHealthShareUsageDescription": "AORANE reads your health data from HealthKit to provide personalised health insights.",
        "NSHealthUpdateUsageDescription": "AORANE writes workout and activity data to HealthKit to keep your health records in sync.",
        "NSCameraUsageDescription": "AORANE uses the camera to scan food items and analyse nutritional content.",
        "NSUserNotificationsUsageDescription": "AORANE sends reminders for medicines, water intake and daily health tips."
      }
    },
    "android": {
      "package": "in.aorane.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#010814"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "aorane.in",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://aorane.onrender.com"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "buildToolsVersion": "35.0.0",
            "kotlinVersion": "2.0.21",
            "ndkVersion": "27.1.12297006",
            "enableProguardInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AORANE uses your location to find nearby doctors, pharmacies and hospitals."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "AORANE uses Face ID for quick and secure login."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "5aae481e-0658-442e-9f6c-9521b4d58954"
      }
    }
  }
}
