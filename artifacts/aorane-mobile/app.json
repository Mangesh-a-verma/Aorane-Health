{
  "expo": {
    "name": "AORANE",
    "slug": "aorane-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aorane",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#010814"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.aorane.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "AORANE ko nazdeeki doctors, pharmacies aur hospitals dhundne ke liye aapki location chahiye.",
        "NSFaceIDUsageDescription": "Quick login ke liye Face ID use karna chahte hain.",
        "NSHealthShareUsageDescription": "AORANE aapki health data dekhne ke liye HealthKit access chahta hai.",
        "NSUserNotificationsUsageDescription": "Medicine reminders aur health tips ke liye notifications chahiye."
      }
    },
    "android": {
      "package": "in.aorane.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#010814"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACTIVITY_RECOGNITION",
        "BODY_SENSORS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://aorane.onrender.com"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "AORANE ko nearby doctors/hospitals dhundne ke liye location chahiye."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Face ID se quick login ke liye allow karein."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    }
  }
}
