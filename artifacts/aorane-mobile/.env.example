# Aorane Mobile (Expo) — Environment Variables
# Copy to .env for local dev (Expo reads EXPO_PUBLIC_* vars automatically).
# For EAS builds, set these as EAS secrets instead: `eas secret:create`.

# Base URL of the api-server
EXPO_PUBLIC_API_URL=http://localhost:3000

# google-services.json is NOT an env var — see google-services.json.example
# in this folder. Never commit the real google-services.json; keep it out of
# git and upload it as a build secret in EAS/Codemagic instead.
