# Aorane Business Portal — Environment Variables
# Copy to .env.local for local dev. In Vercel, set these in Project Settings → Environment Variables.

# Base URL of the api-server this admin panel talks to
VITE_API_URL=http://localhost:3000

# Business portal URL (used for cross-linking, e.g. from Organizations page)
VITE_BUSINESS_URL=http://localhost:5174
