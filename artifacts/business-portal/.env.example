# Aorane Business Portal — Environment Variables
# Copy to .env.local for local dev. In Vercel, set these in Project Settings → Environment Variables.

# Base URL of the api-server this admin panel talks to
VITE_API_URL=http://localhost:3000

# Business portal URL (used for cross-linking, e.g. from Organizations page)
VITE_BUSINESS_URL=http://localhost:5174

# ── Marketing/analytics (optional) ──────────────────────────────────────
# Leave any of these blank and the app runs normally — that destination
# simply never loads. Consent banner still shows regardless.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_PROJECT_ID=
# B2B-only: LinkedIn Insight Tag partner ID
VITE_LINKEDIN_PARTNER_ID=
