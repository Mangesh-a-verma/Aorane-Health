# ─────────────────────────────────────────────────────────────────────────
# Aorane API Server — Environment Variables
# Copy this file to `.env` for local dev. In Render/Vercel, set these as
# dashboard environment variables — never commit a real .env file.
# ─────────────────────────────────────────────────────────────────────────

# ── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | test | staging | production
PORT=3000
LOG_LEVEL=info                # trace | debug | info | warn | error

# ── Database (one of these two is required) ───────────────────────────────
DATABASE_URL=postgres://user:password@localhost:5432/aorane
# If using Supabase, prefer the pooled connection string in production:
SUPABASE_DATABASE_URL=

# ── Auth secrets (REQUIRED in staging/production — server refuses to boot
#    without them; only development/test allow an insecure fallback) ───────
JWT_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_SECRET=
BUSINESS_JWT_SECRET=

# ── AI provider key encryption (Phase 3) ───────────────────────────────
# Encrypts per-feature API key overrides saved from Admin Panel > AI
# Configuration before storing them in the database. Without this set,
# those keys are stored in PLAINTEXT (a warning is logged on every use).
# Generate with: openssl rand -hex 32
# IMPORTANT: once set and used, do not lose this value — it cannot be
# recovered, and losing it makes every already-encrypted key unusable
# (you'd need to re-enter them in Admin Panel after rotating this).
AI_CONFIG_ENCRYPTION_KEY=

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of extra allowed origins on top of the built-in
# aorane.com / admin.aorane.com / business.aorane.com whitelist.
ALLOWED_ORIGIN=

# ── Razorpay (payments) ─────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Google Play Billing (Android native subscriptions) ─────────────────────
# Service account JSON (single-line string, or base64-encoded) for a GCP
# service account granted the "Play Android Developer" role in
# Play Console > Users and permissions > Invite new user. NEVER commit the
# actual value — set it only in the deploy environment's secret manager.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=in.aorane.app
# Full public URL of the RTDN webhook (used as the OIDC token audience for
# verifying Pub/Sub push requests actually came from Google), e.g.
# https://aorane.onrender.com/api/webhooks/google-play
GOOGLE_RTDN_WEBHOOK_URL=
# Email of the service account Pub/Sub uses to sign push-subscription OIDC
# tokens (set when creating the Pub/Sub push subscription in Cloud Console).
# Optional extra check tightening RTDN verification beyond audience match.
GOOGLE_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=

# ── SMS / WhatsApp OTP providers (at least one recommended) ────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAST2SMS_API_KEY=
WHATSAPP_VERIFY_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@aorane.com

# ── AI providers ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Third-party integrations ────────────────────────────────────────────
OPENWEATHER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_FIT_CLIENT_ID=
GOOGLE_FIT_CLIENT_SECRET=
FIREBASE_API_KEY=

# ── Business config ─────────────────────────────────────────────────────
AORANE_GSTIN=
APP_URL=https://aorane.com
API_BASE_URL=https://api.aorane.com

# ── Render keep-alive (set automatically by Render, leave blank locally) ──
RENDER_EXTERNAL_URL=

# ── QA / testing only ────────────────────────────────────────────────────
# Comma-separated allow-lists so QA can bypass real OTP delivery in non-prod.
TEST_EMAILS=
TEST_PHONES=
